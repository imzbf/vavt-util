{
  "name": "@vavt/util",
  "version": "2.2.0",
  "license": "MIT",
  "keywords": [
    "js",
    "util"
  ],
  "description": "JavaScript library.",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mts",
    "build": "node ./scripts/build.lib.mts && node ./scripts/build.types.mts",
    "build:type": "node ./scripts/build.types.mts",
    "test": "npm run build:type && node --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "homepage": "https://imzbf.github.io/vavt-util/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imzbf/vavt-util.git"
  },
  "bugs": {
    "url": "https://github.com/imzbf/vavt-util/issues"
  },
  "files": [
    "lib"
  ],
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/es/index.mjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vavt/message": "^2.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "**/*.{ts,mts,md,json}": [
      "prettier --write"
    ],
    "**/*.{ts,mts}": [
      "eslint --quiet --fix"
    ]
  }
}
